{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repo Memory Decision Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "subject", "summary", "status", "evidence", "created"],
  "properties": {
    "kind": {"enum": ["decision", "constraint", "lesson", "observation", "workaround"]},
    "subject": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1, "maxLength": 4096},
    "status": {"enum": ["proposed", "active", "superseded", "expired"]},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "ref"],
        "properties": {
          "type": {"enum": ["repository", "git", "issue", "test", "external"]},
          "ref": {"type": "string", "minLength": 1}
        }
      }
    },
    "created": {"type": "string"},
    "expires": {"type": ["string", "null"]},
    "supersedes": {"type": "array", "items": {"type": "string"}}
  }
}
